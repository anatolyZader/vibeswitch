#!/usr/bin/env bash
# Pre-commit hook: lightweight local checks before every commit.
# Install: cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or run: npm run setup:hooks

set -euo pipefail

echo "=== VibeSwitch pre-commit checks ==="

# 1. Prevent direct commits to main
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ]; then
    echo "❌ ERROR: Direct commits to 'main' are not allowed."
    echo "   Create a feature branch first: git checkout -b feat/scope/description"
    exit 1
fi

# 2. Check for secrets / sensitive patterns in staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED_FILES" ]; then
    # Check for common secret patterns
    SECRETS_FOUND=0
    for file in $STAGED_FILES; do
        if [ -f "$file" ]; then
            # Skip binary files and lock files
            case "$file" in
                *.vsix|*.png|*.jpg|*.gif|*.ico|package-lock.json) continue ;;
            esac
            # Check for common secret patterns (API keys, tokens, passwords)
            if grep -qEi '(api[_-]?key|secret|password|token)\s*[:=]\s*["\x27][A-Za-z0-9+/=]{16,}' "$file" 2>/dev/null; then
                echo "⚠️  WARNING: Possible secret in $file"
                SECRETS_FOUND=1
            fi
        fi
    done
    if [ "$SECRETS_FOUND" -eq 1 ]; then
        echo "   Review staged files for secrets before committing."
        echo "   To bypass (if false positive): git commit --no-verify"
    fi
fi

# 3. Lint staged JS/JSX files (fast: only changed files)
JS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|jsx)$' || true)
if [ -n "$JS_FILES" ]; then
    echo "Running ESLint on staged files..."
    # Only lint files that still exist (not deleted)
    EXISTING_JS=""
    for f in $JS_FILES; do
        [ -f "$f" ] && EXISTING_JS="$EXISTING_JS $f"
    done
    if [ -n "$EXISTING_JS" ]; then
        npx eslint $EXISTING_JS --max-warnings 150 --quiet 2>/dev/null || {
            echo "❌ ESLint found errors in staged files. Fix before committing."
            exit 1
        }
        echo "  ✓ ESLint passed"
    fi
fi

# 4. Validate commit message format (Conventional Commits)
# Note: this runs on the commit message file, only works with prepare-commit-msg hook
# For pre-commit, we just check branch naming as a proxy

echo "  ✓ Branch: $BRANCH"
echo "=== Pre-commit checks passed ==="
