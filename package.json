{
  "name": "vibeswitch",
  "displayName": "VibeSwitch - Stay Aware, Stay in Control: Steer Your AI Speed",
  "description": "Stop working on autopilot with AI. Live awareness monitoring helps you stay conscious and intentional.",
  "version": "1.0.0",
  "publisher": "your-publisher-name",
  "icon": "ui/images/logo-steering-stick.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cursor",
    "ai",
    "awareness",
    "collaboration",
    "productivity",
    "agent",
    "monitoring",
    "vibe",
    "dev",
    "feedback"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibeswitch.switchMode",
        "title": "Switch AI Collaboration Mode",
        "category": "VibeSwitch"
      },
      {
        "command": "vibeswitch.toVibe",
        "title": "Switch to VIBE Mode (Fast & Autonomous)",
        "category": "VibeSwitch"
      },
      {
        "command": "vibeswitch.toDev",
        "title": "Switch to DEV Mode (Slow & Aware)",
        "category": "VibeSwitch"
      },
      {
        "command": "vibeswitch.showStats",
        "title": "Show Awareness Report",
        "category": "VibeSwitch"
      },
      {
        "command": "vibeswitch.resetStats",
        "title": "Reset Statistics (Clear All Data)",
        "category": "VibeSwitch"
      },
      {
        "command": "vibeswitch.exportStats",
        "title": "Export Statistics to JSON",
        "category": "VibeSwitch"
      },
      {
        "command": "vibeswitch.showLogs",
        "title": "Show Extension Logs",
        "category": "VibeSwitch"
      },
      {
        "command": "vibeswitch.showStatusBar",
        "title": "Show Status Bar Items",
        "category": "VibeSwitch"
      },
      {
        "command": "vibeswitch.diagnoseMonitor",
        "title": "Diagnose Awareness Monitor",
        "category": "VibeSwitch"
      },
      {
        "command": "vibeswitch.diagnoseDecorations",
        "title": "Diagnose File Decorations",
        "category": "VibeSwitch"
      },
      {
        "command": "vibeswitch.detectTestingFiles",
        "title": "Detect Testing Files",
        "category": "VibeSwitch"
      },
      {
        "command": "vibeswitch.showUnreviewedFiles",
        "title": "Show Unreviewed Files",
        "category": "VibeSwitch"
      },
      {
        "command": "vibeswitch.testAddAICode",
        "title": "Test: Add AI Code with Marker",
        "category": "VibeSwitch"
      }
    ],
    "keybindings": [
      {
        "command": "vibeswitch.switchMode",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      }
    ],
    "configuration": {
      "title": "VibeSwitch",
      "properties": {
        "vibeswitch.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show mode indicator and awareness meter in status bar"
        },
        "vibeswitch.rulesPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to .cursor/rules.md files (leave empty for workspace root)"
        },
        "vibeswitch.autoReload": {
          "type": "boolean",
          "default": false,
          "description": "[DEPRECATED] Not used - mode switches are instant via .cursor/rules.md"
        },
        "vibeswitch.skipCursorSettings": {
          "type": "boolean",
          "default": false,
          "description": "[DEPRECATED] Not used - extension only modifies .cursor/rules.md, not settings"
        },
        "vibeswitch.enableTelemetry": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time awareness monitoring and long-term statistics (100% local, never sent anywhere)"
        }
      }
    }
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "package": "vsce package",
    "lint": "echo 'No linter configured yet'",
    "create-md": "node scripts/create-md.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.19.0",
    "glob": "^13.0.0",
    "jest": "^30.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/vibeswitch"
  },
  "license": "MIT"
}
